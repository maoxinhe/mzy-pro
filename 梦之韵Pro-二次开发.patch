--- a/Plain Craft Launcher 2/Modules/Base/ModSetup.cs	
+++ b/Plain Craft Launcher 2/Modules/Base/ModSetup.cs	
@@ -2,6 +2,7 @@
 using System.Windows;
 using System.Windows.Media;
 using System.Windows.Media.Effects;
+using System.Windows.Media.Imaging;
 using PCL.Core.App;
 using PCL.Core.App.Configuration;
 using PCL.Core.IO.Net.Http;
@@ -122,6 +123,7 @@ public class ModSetup
         UiLauncherTransparent(Config.Preference.Theme.WindowOpacity);
         // 梦之韵Pro：旧版本持久化的蓝色主题统一迁移为淡粉（默认主题为淡粉）
         MigrateLegacyBlueTheme();
+        ApplyDefaultBackground();
         UiLauncherTheme(Config.Preference.Theme.ThemeSelected);
         UiBackgroundColorful(Config.Preference.Background.BackgroundColorful);
         UiLockWindowSize(Config.Preference.LockWindowSize);
@@ -251,6 +253,27 @@ public class ModSetup
         }
     }
 
+    // 梦之韵Pro：默认背景（用户未自定义背景时使用梦之韵主题图）
+    private static void ApplyDefaultBackground()
+    {
+        try
+        {
+            var back = ModMain.frmMain?.ImgBack;
+            if (back is null || back.Background is not null)
+                return; // 已有背景（含用户个性化设置）则不覆盖
+            var brush = new ImageBrush(new BitmapImage(new Uri(
+                "pack://application:,,,/Plain Craft Launcher 2;component/Images/Backgrounds/default_bg.jpg",
+                UriKind.Absolute)))
+            { Stretch = Stretch.UniformToFill };
+            back.Background = brush;
+            back.Visibility = Visibility.Visible;
+        }
+        catch (Exception ex)
+        {
+            ModBase.Log(ex, "[梦之韵Pro] 加载默认背景失败");
+        }
+    }
+
     public static void UiLauncherTheme(int value)
     {
         ThemeManager.ThemeRefresh(value);
