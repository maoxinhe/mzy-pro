+    // 梦之韵Pro：应用自定义主题色（hex -> HSV -> WindowHue/Sat/Light）
+    private void BtnApplyCustomColor_Click(object sender, MouseButtonEventArgs e)
+    {
+        try
+        {
+            var hex = (TextCustomColorHex.Text ?? "").Trim().TrimStart('#');
+            if (hex.Length == 6)
+                hex = "FF" + hex;
+            if (hex.Length != 8)
+            {
+                ModMain.MyMsgBox("请输入正确的十六进制颜色，例如 #FFC0CB 或 #FFFFC0CB。", "梦之韵Pro", isWarn: true);
+                return;
+            }
+            var argb = Convert.ToInt64(hex, 16);
+            var r = (int)((argb >> 16) & 0xFF);
+            var g = (int)((argb >> 8) & 0xFF);
+            var b = (int)(argb & 0xFF);
+
+            // RGB -> HSV
+            double rn = r / 255.0, gn = g / 255.0, bn = b / 255.0;
+            double max = Math.Max(rn, Math.Max(gn, bn)), min = Math.Min(rn, Math.Min(gn, bn));
+            double delta = max - min;
+            double h = 0;
+            if (delta > 0)
+            {
+                if (max == rn) h = 60 * (((gn - bn) / delta) % 6);
+                else if (max == gn) h = 60 * (((bn - rn) / delta) + 2);
+                else h = 60 * (((rn - gn) / delta) + 4);
+            }
+            if (h < 0) h += 360;
+            double s = max == 0 ? 0 : delta / max;
+            double v = max;
+
+            Config.Preference.Theme.WindowHue = (int)Math.Round(h);
+            Config.Preference.Theme.WindowSat = (int)Math.Round(s * 100);
+            Config.Preference.Theme.WindowLight = (int)Math.Round(v * 100);
+            ThemeManager.ThemeRefresh();
+            ModMain.MyMsgBox("已应用自定义主题色！若当前「浅色配色/深色配色」不是「自定义」，请切换到「自定义」以生效。", "梦之韵Pro");
+        }
+        catch (Exception ex)
+        {
+            ModBase.Log(ex, "应用自定义主题色失败");
+            ModMain.MyMsgBox("颜色格式错误，请使用 #RRGGBB 或 #AARRGGBB。", "梦之韵Pro", isWarn: true);
+        }
+    }
